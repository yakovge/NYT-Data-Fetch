# NYT Scraper Environment Configuration
# Copy this to .env and configure with your values

# ═════════════════════════════════════════════════════════════════════
# 🚀 CORE SETTINGS
# ═════════════════════════════════════════════════════════════════════

ENVIRONMENT=development
SQLITE_DB_PATH=data/nyt_articles.db
CACHE_TTL_HOURS=24
DATA_DIR=data/

# ═════════════════════════════════════════════════════════════════════
# 🌐 HTTP CLIENT & RATE LIMITING  
# ═════════════════════════════════════════════════════════════════════

REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=5.0
MAX_CONCURRENT_REQUESTS=3
HTTP_TIMEOUT=30
CONNECT_TIMEOUT=10
USE_HTTP2=true
USE_BROTLI=true

# ═════════════════════════════════════════════════════════════════════
# 🔍 AI CONFIGURATION & BUDGETS
# ═════════════════════════════════════════════════════════════════════

AI_PROVIDER=openai
AI_API_KEY=your_api_key_here
MICRO_AI_MODEL=gpt-4o-mini
HEAVY_AI_MODEL=gpt-4o
MICRO_AI_DAILY_BUDGET=30000
HEAVY_AI_DAILY_BUDGET=6000
AI_FALLBACK_RATIO=0.01
MICRO_AI_MAX_RATIO=0.10
HEAVY_AI_MAX_RATIO=0.005
AI_TEMPERATURE=0.1
AI_VALIDATION_ENABLED=true
AI_CACHE_TTL_DAYS=7

# ═════════════════════════════════════════════════════════════════════
# 🏛️ COMPLIANCE & GOVERNANCE
# ═════════════════════════════════════════════════════════════════════

KILL_SWITCH=false
RESPECT_ROBOTS=true
PAYWALL_SENSITIVITY=medium
CHALLENGE_DETECTION_ENABLED=true
CHALLENGE_COOLDOWN_HOURS=24
DRY_RUN_MODE=false
CONTENT_VALIDATION_STRICT=true

# ═════════════════════════════════════════════════════════════════════
# 📊 MONITORING & OBSERVABILITY
# ═════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_ROTATION_SIZE=10MB
LOG_RETENTION_DAYS=30
METRICS_ENABLED=true
METRICS_PORT=8080
METRICS_PATH=/metrics
ALERTS_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
SLO_TRACKING_ENABLED=true
SLO_ERROR_BUDGET_BURN_RATE=0.1
SLO_ALERT_THRESHOLD=0.8

# ═════════════════════════════════════════════════════════════════════
# 🗄️ STORAGE & INDEXING
# ═════════════════════════════════════════════════════════════════════

SEARCH_ENGINE=fts5
FTS5_TOKENIZER=porter unicode61 remove_diacritics 1
FTS5_REBUILD_THRESHOLD=10000
WHOOSH_INDEX_PATH=data/search_index/
EVICTION_ENABLED=true
EVICTION_MAX_AGE_DAYS=30
EVICTION_MAX_SIZE_GB=1.0
EVICTION_BATCH_SIZE=1000
DEDUPLICATION_ENABLED=true
SIMILARITY_THRESHOLD=0.85
SIMHASH_ENABLED=true

# ═════════════════════════════════════════════════════════════════════
# 🎯 PER-HOST BUDGETS & CIRCUIT BREAKERS
# ═════════════════════════════════════════════════════════════════════

DEFAULT_DAILY_REQUEST_LIMIT=1000
DEFAULT_DAILY_BYTE_LIMIT=100000000
NYTIMES_DAILY_REQUEST_LIMIT=5000
NYTIMES_DAILY_BYTE_LIMIT=500000000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=300

# ═════════════════════════════════════════════════════════════════════
# 🔍 DISCOVERY & CONTENT SOURCES
# ═════════════════════════════════════════════════════════════════════

RSS_REFRESH_INTERVAL=30
RSS_MAX_ENTRIES_PER_FEED=100
SITEMAP_REFRESH_INTERVAL=60
SITEMAP_MAX_URLS=1000
SEARCH_FALLBACK_ENABLED=true
SEARCH_ENGINES=duckduckgo,startpage,bing
SEARCH_MAX_RESULTS=50
LOCAL_SEARCH_ENABLED=true
SEARCH_CACHE_TTL_HOURS=6